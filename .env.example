# Copy to .env (git-ignored, chmod 600). Run with: uv run --env-file .env buddy serve
# Set the channels you use; serve listens on every one that is set.

# Lark / Feishu: App ID and App Secret of the self-built app, on buddy.toml's domain
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=

# Both Lark and Feishu: FEISHU_APP_ID above is the Feishu (China) app, with domain = "feishu",
# and this is the Lark (international) one; its chats and people read lark:oc_..., lark:ou_...
LARK_APP_ID=
LARK_APP_SECRET=

# Telegram: the token @BotFather gives you
TELEGRAM_BOT_TOKEN=

# Comma-separated ids allowed to use the bot: ou_… (Lark open_id), tg:… (Telegram user).
# Leave empty on first run: the bot then refuses every sender and replies with their id.
BUDDY_ALLOWED_IDS=
